# Supabase project credentials — Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose to the browser; every table is protected by the
# row-level security policies in supabase/migrations. Never add the service_role
# key here — this app deliberately has no way to bypass RLS.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public origin of the deployment. Share links and Open Graph tags build
# absolute URLs from this, so shared listings unfurl with the wrong host if it
# is unset. Leave as localhost for development.
PUBLIC_SITE_URL=http://localhost:4321
