---
import type { Listing, Location } from '../lib/types';
import { expiryLabel } from '../lib/format';
import { siteConfig } from '../config';
import Avatar from './Avatar.astro';
import RelativeTime from './RelativeTime.astro';
import ReactionButton from './ReactionButton.astro';
import ShareMenu from './ShareMenu.astro';

interface Props {
  listing: Listing;
  locations?: Location[];
  /** Full detail view: show skills/contact and skip the body clamp. */
  detail?: boolean;
}

const { listing, locations = [], detail = false } = Astro.props;

const signedIn = Boolean(Astro.locals.user);
const isAuthor = Astro.locals.user?.id === listing.author_id;
const href = `/listings/${listing.id}`;
const shareUrl = new URL(href, Astro.site ?? siteConfig.site).href;
const loginHref = `/login?next=${encodeURIComponent(href)}`;

const locationName = locations.find(l => l.slug === listing.location)?.name ?? listing.location;
const expiry = expiryLabel(listing.expires_at);
const closed = expiry?.text === 'Closed';
const heading = listing.title || 'Volunteer request';
---

<article class:list={['post', { closed, detail }]}>
  <header class="post-head">
    <Avatar profile={listing.author} size={42} link />
    <div class="who">
      <div class="line">
        {listing.author?.username ? (
          <a href={`/u/${listing.author.username}`} class="name">
            {listing.author.display_name || listing.author.username}
          </a>
        ) : (
          <span class="name">Someone</span>
        )}
        {isAuthor && <span class="pill you">You</span>}
      </div>
      <div class="line meta">
        <RelativeTime date={listing.created_at} href={detail ? undefined : href} />
        {locationName && (
          <>
            <span class="dot">·</span>
            <a href={`/listings?location=${listing.location}`} class="loc">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              {locationName}
            </a>
          </>
        )}
      </div>
    </div>
    {expiry && (
      <span class:list={['pill', { 'pill-warning': expiry.tone === 'warning', 'pill-danger': expiry.tone === 'danger' }]}>
        {expiry.text}
      </span>
    )}
  </header>

  <div class="post-body">
    {detail
      ? <h1 class="title">{heading}</h1>
      : <h2 class="title"><a href={href}>{heading}</a></h2>}

    <p class:list={['body', { clamp: !detail }]}>{listing.body}</p>

    {detail && listing.skills && (
      <section class="detail-block">
        <h3>Skills needed</h3>
        <p>{listing.skills}</p>
      </section>
    )}

    {detail && listing.contact && (
      <section class="detail-block">
        <h3>How to get in touch</h3>
        <p>{listing.contact}</p>
      </section>
    )}

    {!detail && (
      <a href={href} class="more">
        Read more
        {listing.reply_count ? ` · ${listing.reply_count} ${listing.reply_count === 1 ? 'reply' : 'replies'}` : ''}
      </a>
    )}
  </div>

  <footer class="post-actions">
    {siteConfig.features?.reactions && (
      <ReactionButton
        listingId={listing.id}
        count={listing.reaction_count ?? 0}
        reacted={Boolean(listing.viewer_reacted)}
        signedIn={signedIn}
        loginHref={loginHref}
      />
    )}

    <a href={detail ? '#reply' : href} class="action-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/>
      </svg>
      <span>Reply</span>
      {(listing.reply_count ?? 0) > 0 && <span class="count">{listing.reply_count}</span>}
    </a>

    {siteConfig.features?.share && <ShareMenu url={shareUrl} title={heading} />}
  </footer>
</article>

<style>
  .post {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    padding: 1.1rem 1.25rem 0.6rem;
    margin-bottom: 1rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .post:hover { border-color: var(--border-color-hover); }
  .post.detail { margin-bottom: 1.5rem; }
  .post.closed { opacity: 0.72; }

  .post-head {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-bottom: 0.75rem;
  }

  .who { flex: 1; min-width: 0; }

  .line { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }

  .name {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .name:hover { color: var(--color-primary); }

  .meta { font-size: 0.8125rem; color: var(--text-tertiary); }
  .dot { color: var(--text-tertiary); }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
  }
  .loc:hover { color: var(--color-primary); }

  .pill.you { background: var(--color-primary-light); color: var(--color-primary); }

  .title { font-size: 1.0625rem; margin-bottom: 0.35rem; }
  .post.detail .title { font-size: 1.5rem; margin-bottom: 0.6rem; }
  .title a { color: var(--text-primary); }
  .title a:hover { color: var(--color-primary); }

  .body {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin-bottom: 0.5rem;
  }

  /* Feed cards preview the request; the detail page shows all of it. */
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .detail-block { margin-top: 1.25rem; }
  .detail-block h3 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    margin-bottom: 0.25rem;
  }
  .detail-block p { white-space: pre-wrap; overflow-wrap: anywhere; margin: 0; }

  .more {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.35rem;
    margin-top: 0.5rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    padding: 0.45rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-radius: 10px;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .action-btn:hover { background: var(--bg-secondary); color: var(--color-primary); }
  .count { font-variant-numeric: tabular-nums; }
</style>
