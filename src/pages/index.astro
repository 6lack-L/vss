---
import { actions } from 'astro:actions';
import BaseLayout from '../layouts/BaseLayout.astro';
import Composer from '../components/Composer.astro';
import PostCard from '../components/PostCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { siteConfig } from '../config';
import { fetchListings, fetchLocations, fetchViewerReactions } from '../lib/listings';

const { supabase, user } = Astro.locals;

// Present when the composer posted back to this page.
const result = Astro.getActionResult(actions.createListing);
if (result && !result.error) {
  return Astro.redirect(`/listings/${result.data.id}`, 303);
}
const composerError = result?.error?.message ?? null;

const [listings, locations] = await Promise.all([
  fetchListings(supabase, { sort: 'newest', openOnly: true, limit: 30 }),
  fetchLocations(supabase),
]);

const reacted = await fetchViewerReactions(supabase, user?.id, listings.map(l => l.id));
for (const l of listings) l.viewer_reacted = reacted.has(l.id);
---

<BaseLayout title={siteConfig.title + ' - Volunteer requests near you'}>
  <main class="container-narrow">
    <header class="feed-head">
      <h1>Volunteer requests</h1>
      <p>{siteConfig.description}</p>
    </header>

    {user ? (
      <Composer locations={locations} error={composerError} />
    ) : (
      <div class="signed-out card">
        <p>
          <strong>Need a hand, or want to give one?</strong>
          Sign in to post a request and reply to your neighbours.
        </p>
        <div class="cta">
          <a href="/signup" class="btn">Create an account</a>
          <a href="/login" class="btn btn-secondary">Sign in</a>
        </div>
      </div>
    )}

    {listings.length === 0 ? (
      <EmptyState
        title="Nothing open right now"
        message="No volunteer requests are currently taking replies. Check the full list for closed ones, or post the first request."
        actionHref="/listings"
        actionLabel="Browse all listings"
      />
    ) : (
      listings.map(listing => <PostCard listing={listing} locations={locations} />)
    )}

    {listings.length > 0 && (
      <p class="more-link"><a href="/listings">Browse all listings, including closed ones →</a></p>
    )}
  </main>
</BaseLayout>

<style>
  .feed-head { margin-bottom: 1.5rem; }
  .feed-head h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .feed-head p { color: var(--text-secondary); margin: 0; }

  .signed-out { margin-bottom: 1.5rem; }
  .signed-out p { margin-bottom: 1rem; }
  .signed-out strong { color: var(--text-primary); display: block; margin-bottom: 0.15rem; }
  .cta { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .more-link { text-align: center; font-size: 0.875rem; margin: 1.5rem 0 0; }
</style>
